# Plantilla de variables para levantar Tero en local con docker compose.
# Copiar a .env (que está en .gitignore) y completar con valores propios:
#   cp .env.example .env
# En AWS estos valores no salen de un archivo: ECS los inyecta desde Secrets Manager.

# Base de datos (PostgreSQL)
# init-db.sql asume el usuario retail_user y la base orders: no cambiarlos sin ajustar ese script.
POSTGRES_USER=retail_user
POSTGRES_PASSWORD=
POSTGRES_DB=orders

# Panel de administración
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Secreto para firmar los JWT del admin (generarlo, por ejemplo: openssl rand -hex 32)
ADMIN_JWT_SECRET=
